# Optional HSJM Linux Docker overrides.
# The container runs without this file and then uses API appsettings.json.
# To override these operational values, copy this file to .env and run:
# chmod 0600 .env

# Leave empty to let start.sh select a free host port from 28000-28999.
# To use a fixed port, set a value such as HSJM_HTTP_PORT=28505.
HSJM_HTTP_PORT=
HSJM_TIME_ZONE=Asia/Shanghai
HSJM_START_TIMEOUT_SECONDS=240

# Optional: only uncomment when Redis requires authentication.
# CSRedis format: host:port,password=CHANGE_ME,defaultDatabase=0
# HSJM_REDIS_CONNECTION=192.168.6.131:6379,password=CHANGE_ME,defaultDatabase=0
