    <Folder Include="20dll\" />
  </ItemGroup>
  <Target Name="WarnNoTiaSdk" BeforeTargets="BeforeBuild" Condition="'$(TiaSdkDir)' == ''">
    <Warning Text="未找到 TIA Portal Openness SDK（20dll/19dll/18dll 及本机已安装的 Portal V15.1~V20 PublicAPI 均无 Siemens.Engineering.dll）：本次编译为无 SDK 提示版。目标机为 TIA Portal V20 时，请把远程机 C:\Program Files\Siemens\Automation\Portal V20\PublicAPI\V20\ 下的 Siemens.Engineering.dll 与 Siemens.Engineering.Hmi.dll 拷入本项目 20dll\ 文件夹后重新编译。" />
  </Target>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
