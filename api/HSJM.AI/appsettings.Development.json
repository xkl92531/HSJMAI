{
  "WebConfig": {
    "RedisServerUrl": "127.0.0.1:6379",
    "BackgroundJobs": {
      "Enabled": true
    },
    "Hangfire": {
      "LocalOnlyQueues": true
    },
    "LineUpMonitor": {
      "Enabled": true,
      "PollIntervalMs": 1000
    },
    "LineUp": {
      "ImportRoot": "App_Data/lineup-imports",
      "StorageRoot": ""
    }
  },
  "TestConstraintV2": {
    "ManualModeReadEnabled": true
  },
  "IndependentPlcPipeline": {
    "Enabled": true,
    "ExpectedDatabase": "hsjm_ai_new_test"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "System": "Information",
      "Microsoft": "Information"
    }
  }
}
