{
  "WebConfig": {
    "DBList": [
      {
        "ConfigId": "DefultDataBase1",
        //"ConnectionString": "",
        // 池参数收敛（2026-08-25）：共享 PG 服务器 max_connections=100，被 lineup 等 38+ 连接挤压；
        // Npgsql 默认 MaxPoolSize=100/进程过大，收敛为 30；Timeout=15 避免连接等待无限挂起。
        // 长命令加固（2026-08-27）：Command Timeout=600 覆盖 86.9 万行接口 BulkCopy 长命令（默认仅 30s）；
        // Keepalive=60 TCP 层保活，防长传输被中间设备掐断（实测 Exception while reading from stream）。
        "ConnectionString": "",
        //"ConnectionString": "",
        "DatabaseType": "SqlServer"
      },
      {
        "ConfigId": "DefultDataBase",
        // Hangfire 池收敛（2026-08-25）：队列轮询为主低并发，100→20 足够，给共享 PG 留预算。
        // 长命令加固（2026-08-27）：同业务库，Command Timeout=600 + Keepalive=60（见上）。
        "ConnectionString": "",
        "DatabaseType": "PostgreSQL"
      },
      {
        "ConfigId": "quest",
        "ConnectionString": "",
        "DatabaseType": "QuestDb"
      }
    ],

    "AllowedIpAddresses": [ "::1", "127.0.0.1", "localhost" ], //IP不在名单中则无法访问,*代表所有都可以
    /* 雪花算法生成主键数据中心id(负载均衡部署，每个服务配置需唯一，防止id重复)*/
    "DataCenterId": 1,
    /* 雪花算法生成主键机器id*/
    "MachineId": 1,
    "RedisServerUrl": "127.0.0.1:6379",
    "Hangfire": {
      "PrepareSchemaIfNecessary": false
    },
    "ServiceApiHosts": [
      {
        "Code": "XX.COM",
        "Host": "127.0.0.1"
      },
      {
        "Code": "YY.COM",
        "Host": "127.0.0.1"
      }
    ],
    "RabbitMQConfig": {
      "RabbitMQHostList": [ "127.0.0.1" ],
      "RabbitMQUserName": "rabbitmq",
      "RabbitMQPassword": "",
      "RabbitMQVirtualHost": "GCL_MES",
      "MQMaxConnectionCount": 30
    },
    "MongoDBConfig": {
      "MongoDbUrl": "",
      "MongoDbName": "mes"
    },
    "ElasticSearchConfig": {
      "ClusterNodeUrlHosts": [ "127.0.0.1:9200" ],
      "IsOpenDebugger": false
    },
    "JWTConfig": {
      "SecurityKey": "",
      "Issuer": "hj-robot.com",
      "Audience": "hj-robot.com",
      "ExpiresMinutes": 480
    },
    //"BackgroundJobs": {
    //  "Enabled": false
    //},
    "LineUpMonitor": {
      "Enabled": true,
      "PollIntervalMs": 1000
    },
    "HangfireDashboard": {
      // 发布后是否直接放行 /hangfire。外网环境建议改为 false，并设置 AccessToken 或 AllowedIpAddresses。
      "AllowAnonymous": true,
      // AllowAnonymous=false 时，可通过 /hangfire?access_token=你的令牌 访问，首次通过后会写入 HttpOnly Cookie。
      "AccessToken": "",
      "AllowedIpAddresses": [ "::1", "127.0.0.1", "localhost" ]
    },
    "AIAgent": {
      "MaxIterations": 20,
      "TimeoutSeconds": 120,
      "EnableFallback": true,
      "DiagnosticAgentRoleId": 2013
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "PythonPath": "D:\\Program Files\\Python\\Python313\\python.exe",
  "DefaultPwd": "",
  "urls": "http://*:2405",
  "AllowedHosts": "*",
  "StationShadowWorker": {
    "Enabled": false,
    "IntervalSeconds": 60
  },
  "AlarmMonitor": {
    "Enabled": false,
    "IntervalSeconds": 2,
    "StartDebounceCount": 2,
    "EndDebounceCount": 2,
    "BroadcastEnabled": true
  }
}
